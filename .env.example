# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Capture
CAPTURE_INTERFACE=Ethernet
CAPTURE_FLOW_TIMEOUT=120

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=netguard
CLICKHOUSE_USER=netguard
CLICKHOUSE_PASSWORD=change-me

# Auth (optional: creates the first admin at startup)
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_EXPIRE_MINUTES=60

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PREDICT=60/minute

# Signature rules
RULES_ENABLED=true
RULE_WINDOW_SECONDS=10
RULE_PORTSCAN_PORTS=50
RULE_SYNFLOOD_FLOWS=200
RULE_SWEEP_HOSTS=50
RULE_COOLDOWN_SECONDS=60

# Threat intel (keys optional)
INTEL_ENABLED=true
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# JA3 blocklist
JA3_ENABLED=true

# LLM incident reports: auto, ollama, nim or template
LLM_BACKEND=auto
LLM_TIMEOUT_SECONDS=120
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# TheHive (empty URL = disabled)
THEHIVE_URL=
THEHIVE_API_KEY=
THEHIVE_ORG=
THEHIVE_MIN_SEVERITY=high
THEHIVE_TIMEOUT_SECONDS=5