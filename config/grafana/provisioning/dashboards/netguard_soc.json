{
  "title": "NetGuard SOC Dashboard",
  "uid": "netguard-soc-v1",
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Total Flows",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": "ClickHouse",
      "targets": [{
        "rawSql": "SELECT count() FROM netguard.flows WHERE timestamp >= now() - INTERVAL 1 HOUR",
        "format": "table"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Threats Detected",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": "ClickHouse",
      "targets": [{
        "rawSql": "SELECT count() FROM netguard.flows WHERE is_threat = 1 AND timestamp >= now() - INTERVAL 1 HOUR",
        "format": "table"
      }],
      "options": { "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Threat Rate %",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": "ClickHouse",
      "targets": [{
        "rawSql": "SELECT round(countIf(is_threat=1) / count() * 100, 2) FROM netguard.flows WHERE timestamp >= now() - INTERVAL 1 HOUR",
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Avg Inference Time (ms)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": "ClickHouse",
      "targets": [{
        "rawSql": "SELECT round(avg(inference_ms), 2) FROM netguard.flows WHERE timestamp >= now() - INTERVAL 1 HOUR",
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Flows Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 8 },
      "datasource": "ClickHouse",
      "targets": [{
        "rawSql": "SELECT toStartOfMinute(timestamp) as time, label, count() as flows FROM netguard.flows WHERE timestamp >= now() - INTERVAL 1 HOUR GROUP BY time, label ORDER BY time",
        "format": "time_series"
      }],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Benign" },   "properties": [{ "id": "color", "value": { "fixedColor": "green",  "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "DoS" },      "properties": [{ "id": "color", "value": { "fixedColor": "red",    "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Probe" },    "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "R2L" },      "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "U2R" },      "properties": [{ "id": "color", "value": { "fixedColor": "dark-red","mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 6,
      "title": "Attack Type Breakdown",
      "type": "piechart",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": "ClickHouse",
      "targets": [{
        "rawSql": "SELECT label, count() as count FROM netguard.flows WHERE timestamp >= now() - INTERVAL 1 HOUR GROUP BY label ORDER BY count DESC",
        "format": "table"
      }],
      "options": {
        "pieType": "donut",
        "legendDisplayMode": "table",
        "legendPlacement": "right"
      }
    },
    {
      "id": 7,
      "title": "Recent Alerts",
      "type": "table",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "datasource": "ClickHouse",
      "targets": [{
        "rawSql": "SELECT timestamp, src_ip, src_port, dst_ip, dst_port, label, round(confidence,3) as confidence, round(anomaly_score,3) as anomaly_score, round(inference_ms,1) as inference_ms FROM netguard.flows WHERE is_threat = 1 ORDER BY timestamp DESC LIMIT 50",
        "format": "table"
      }],
      "options": {
        "sortBy": [{ "displayName": "timestamp", "desc": true }]
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "label" },
            "properties": [{
              "id": "custom.displayMode",
              "value": "color-background",
              "mappings": [
                { "type": "value", "options": { "DoS":   { "color": "red",    "index": 0 } } },
                { "type": "value", "options": { "Probe": { "color": "orange", "index": 1 } } },
                { "type": "value", "options": { "R2L":   { "color": "purple", "index": 2 } } },
                { "type": "value", "options": { "U2R":   { "color": "dark-red","index": 3 } } }
              ]
            }]
          },
          {
            "matcher": { "id": "byName", "options": "confidence" },
            "properties": [{ "id": "custom.displayMode", "value": "gradient-gauge" }]
          }
        ]
      }
    }
  ]
}
